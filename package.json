{
  "name": "ubc-hunch",
  "private": true,
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "bun run --cwd apps/api dev",
    "dev:mobile": "bun run --cwd apps/mobile start",
    "typecheck": "bun run --filter \"@hunch/*\" typecheck",
    "db:up": "docker compose up -d --wait",
    "db:generate": "bun run --cwd apps/api db:generate",
    "db:migrate": "bun run --cwd apps/api db:migrate",
    "db:seed:campuses": "bun run --cwd apps/api db:seed:campuses",
    "arc:index": "bun run --cwd apps/api arc:index",
    "arc:treasury": "bun run --cwd apps/api arc:treasury",
    "test": "bun run --cwd apps/api test"
  },
  "devDependencies": {
    "typescript": "~6.0.3"
  }
}
